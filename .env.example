# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to obtain the token and username.
# Note: Use /setdomain on @BotFather to link your deployment domain for the official Telegram Login Widget.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_USERNAME="your_telegram_bot_username"

# Admin Dashboard Access
ADMIN_PASSWORD="admin_secure_passphrase_here"

# UPI Payment Configuration
UPI_ID="tharak4321@slc"
UPI_PAYEE_NAME="Actorsparadise"
ADMIN_CONTACT_TELEGRAM="dragonbreath1"

# Supabase Configuration (Optional for local test; recommended for production Vercel deployment)
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
